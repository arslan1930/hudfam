# TechxForm — Hostinger / LiteSpeed safe (plain PHP)
DirectoryIndex index.php index.html

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Direct /assets/ hits (asset.php?v=mtime is the app path and uses immutable cache).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Do not expose private PHP folders as URLs
  RewriteRule ^(includes|pages|sql)(/|$) - [F,L]

  # Real files (CSS, JS, images, asset.php, install.php, etc.) — serve as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else → front controller (avoids Hostinger 403 on directories)
  RewriteRule ^ index.php [L]
</IfModule>

<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<FilesMatch "^(tests_run|tests_http|smoke_admin_mvp|reset_admin_once|upgrade)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
